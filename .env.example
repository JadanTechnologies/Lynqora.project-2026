# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string or PGlite data directory
DATABASE_URL="postgres://user:password@localhost:5432/lynqora"

# AUTH_SECRET: JWT signing key for secure session authentication
AUTH_SECRET="your-super-secret-jwt-key-change-in-production-2026"

# Port is fixed to 3000 by AI Studio container proxy
PORT=3000

# --- Phase 2: Verification Engine ---
# Domain registration provider (RDAP). Leave empty to disable.
RDAP_PROVIDER_URL=
# WHOIS API provider. Leave empty to disable.
WHOIS_API_KEY=
# WHOIS API base URL (optional, defaults to https://api.whois.vu)
WHOIS_API_URL=
# Domain info cache duration in minutes (default: 60)
DOMAIN_INFO_CACHE_MINUTES=60
# Verification engine timeouts (milliseconds)
REQUEST_TIMEOUT=10000
MAX_REDIRECTS=5
MAX_RESPONSE_SIZE=2097152
